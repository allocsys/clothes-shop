# Copy to .env on the server and fill in.

# Your domain, without https:// and without www (needs an A record pointing at the server IP)
DOMAIN=example.ir

# Database password. Use letters and digits only. Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# POSTGRES_USER=shop
# POSTGRES_DB=shop

# Only if Docker Hub / npm are not reachable from the server, point these at a mirror:
# NODE_IMAGE=node:22-alpine
# CADDY_IMAGE=caddy:2-alpine
# POSTGRES_IMAGE=postgres:16-alpine
# NPM_REGISTRY=https://registry.npmjs.org/

# Product photos are stored on the server disk (the `uploads` volume). Only when you later move them to
# ArvanCloud / a CDN, set their public base URL here and rebuild (docker compose up -d --build):
# NEXT_PUBLIC_MEDIA_BASE_URL=https://your-bucket.s3.ir-thr-at1.arvanstorage.ir
