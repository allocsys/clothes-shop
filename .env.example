# Copy to .env on the server and fill in.

# Your domain, without https:// and without www (needs an A record pointing at the server IP)
DOMAIN=example.ir

# Database password. Use letters and digits only. Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# POSTGRES_USER=shop
# POSTGRES_DB=shop

# Off-server backup copy, used by scripts/backup.sh (set ONE; see docs/DEPLOY_VPS.md). Without it the backups stay on this server only.
# Another server over SSH (rsync on both sides) and optionally the SSH key to use:
# BACKUP_RSYNC_TARGET=user@other-server:/home/user/mahpari-backups
# BACKUP_SSH_KEY=/root/.ssh/backup_key
# Or a PRIVATE bucket through rclone (e.g. ArvanCloud S3), remote made with `rclone config`:
# BACKUP_RCLONE_REMOTE=arvan:my-bucket/mahpari

# Only if Docker Hub / npm are not reachable from the server, point these at a mirror:
# NODE_IMAGE=node:22-alpine
# CADDY_IMAGE=caddy:2-alpine
# POSTGRES_IMAGE=postgres:16-alpine
# NPM_REGISTRY=https://registry.npmjs.org/

# Product photos are stored on the server disk (the `uploads` volume). Only when you later move them to
# ArvanCloud / a CDN, set their public base URL here and rebuild (docker compose up -d --build):
# NEXT_PUBLIC_MEDIA_BASE_URL=https://your-bucket.s3.ir-thr-at1.arvanstorage.ir

# Password for the admin panel (/admin). REQUIRED to unlock it: without it the panel stays locked.
# Use a long random one, and keep it out of Git. Changing it logs everybody out.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Online payment (gateway-agnostic). Leave PAYMENT_PROVIDER empty to keep payment OFF:
# orders are saved and the shop contacts the customer, as before.
# Values: "mock" = FAKE gateway for testing (takes no money, refused in production unless ALLOW_MOCK_PAYMENT=1);
# a real gateway name works once its provider file exists in lib/payments/ (available now: "zarinpal").
# PAYMENT_PROVIDER=
# Zarinpal: the 36-character merchant id from the Zarinpal panel. Without a valid one the gateway counts as
# misconfigured and online payment stays off. The shop's domain must be the one registered for this id.
# ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optional: test against Zarinpal's sandbox instead of the real gateway (no real money).
# ZARINPAL_BASE_URL=https://sandbox.zarinpal.com
# ALLOW_MOCK_PAYMENT=1
# Public address of the shop, no trailing slash. The gateway sends customers back to it. Set it in production.
# SITE_URL=https://example.ir
# Minutes an unpaid ONLINE order keeps its stock before it is canceled and the pieces go back on sale (default 60).
# PAYMENT_HOLD_MINUTES=60

# SMS (provider-agnostic, same idea as payment). Leave SMS_PROVIDER empty to keep SMS OFF.
# Values: "mock" = FAKE provider for testing (sends nothing, only writes the text to the server log;
# refused in production unless ALLOW_MOCK_SMS=1); a real provider name (e.g. "kavenegar") works once its
# file exists in lib/sms/. Every message is recorded in the sms_log table.
# SMS_PROVIDER=
# Kavenegar (SMS_PROVIDER=kavenegar): the API key from the Kavenegar panel. Without a valid one the provider
# counts as misconfigured and SMS stays off.
# KAVENEGAR_API_KEY=
# Optional: your sender line number (e.g. 10004346). Empty = the account's default line.
# KAVENEGAR_SENDER=
# ALLOW_MOCK_SMS=1
