# Copy to .env on the server and fill in.

# Your domain, without https:// and without www (needs an A record pointing at the server IP)
DOMAIN=example.ir

# Database password. Use letters and digits only. Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# POSTGRES_USER=shop
# POSTGRES_DB=shop

# Only if Docker Hub / npm are not reachable from the server, point these at a mirror:
# NODE_IMAGE=node:22-alpine
# CADDY_IMAGE=caddy:2-alpine
# POSTGRES_IMAGE=postgres:16-alpine
# NPM_REGISTRY=https://registry.npmjs.org/

# Product photos are stored on the server disk (the `uploads` volume). Only when you later move them to
# ArvanCloud / a CDN, set their public base URL here and rebuild (docker compose up -d --build):
# NEXT_PUBLIC_MEDIA_BASE_URL=https://your-bucket.s3.ir-thr-at1.arvanstorage.ir

# Password for the admin panel (/admin). REQUIRED to unlock it: without it the panel stays locked.
# Use a long random one, and keep it out of Git. Changing it logs everybody out.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Online payment (gateway-agnostic). Leave PAYMENT_PROVIDER empty to keep payment OFF:
# orders are saved and the shop contacts the customer, as before.
# Values: "mock" = FAKE gateway for testing (takes no money, refused in production unless ALLOW_MOCK_PAYMENT=1);
# a real gateway name (e.g. "zarinpal") works once its provider file exists in lib/payments/.
# PAYMENT_PROVIDER=
# ALLOW_MOCK_PAYMENT=1
# Public address of the shop, no trailing slash. The gateway sends customers back to it. Set it in production.
# SITE_URL=https://example.ir
